# BigWigs packager configuration (https://github.com/BigWigsMods/packager).
# The repository holds the addon in the folder ForeverMapExplorer. The packager
# copies the repository into .release/ForeverMapExplorer, then moves the addon
# folder up one level, so the zip has ForeverMapExplorer/ForeverMapExplorer.toc.
package-as: ForeverMapExplorer

move-folders:
  ForeverMapExplorer/ForeverMapExplorer: ForeverMapExplorer

enable-nolib-creation: no

manual-changelog: CHANGELOG.md

ignore:
  - .github
  - README.md
  - CHANGELOG.md
  - .gitignore
  - .pkgmeta
